{
  "name": "befirstlady",
  "version": "2.0.0",
  "private": true,
  "description": "Be First Lady — Luxury Spa & Salon · Madinah",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:push": "supabase db push",
    "db:seed": "psql $DATABASE_URL -f supabase/seed/01_categories_services.sql",
    "db:seed:sample": "psql $DATABASE_URL -f supabase/seed/02_sample_data.sql",
    "db:create-users": "tsx scripts/create-test-users.ts",

    "mobile:init": "cap init 'Be First Lady' com.befirstlady.app --web-dir=out",
    "mobile:add:android": "npm run build:static && cap add android",
    "mobile:add:ios": "npm run build:static && cap add ios",
    "mobile:sync": "cap sync",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "mobile:run:android": "cap run android",
    "mobile:run:ios": "cap run ios",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor '#7d613b' --splashBackgroundColor '#fbf7ef'",

    "build:static": "BUILD_TARGET=mobile next build",
    "build:mobile": "npm run build:static && cap sync"
  },
  "dependencies": {
    "next": "15.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@supabase/supabase-js": "^2.46.1",
    "@supabase/ssr": "^0.5.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "date-fns": "^4.1.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.53.2",
    "@hookform/resolvers": "^3.9.1",
    "sonner": "^1.7.0",
    "recharts": "^2.13.3",

    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/toast": "^6.0.0",
    "@capawesome/capacitor-barcode-scanner": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.0.3",
    "supabase": "^1.223.10",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "tsx": "^4.19.2"
  }
}
