# ═══════════════════════════════════════════════════════════════════
# The First Lady · Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# انسخي هذا الملف إلى .env.local للتطوير المحلّي.
# في Vercel · أضيفي كل متغيّر في:
#     Settings → Environment Variables
#
# ⚠️  الأسرار:
#     - لا ترفعي ملف .env للـgit أبداً
#     - اقلبي كل مفتاح لو شاركتيه مع أحد
#
# ═══════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────
# 🌐 الموقع
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://thefirstlady.com
NEXT_PUBLIC_WHATSAPP_NUMBER=966500000000


# ─────────────────────────────────────────────────────────────────
# 🗄️  Supabase · قاعدة البيانات والمصادقة
# ─────────────────────────────────────────────────────────────────
# من:  https://app.supabase.com
#      Project Settings → API
#
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...


# ─────────────────────────────────────────────────────────────────
# 💳 Moyasar · الدفع (مدى · فيزا · Apple Pay · STC Pay)
# ─────────────────────────────────────────────────────────────────
# ✅ البوّابة الوحيدة المفعّلة افتراضيّاً (كافية للصالون)
# من: https://dashboard.moyasar.com → Settings → API Keys
# ⚠️ Live Keys تحتاج توثيق السجل التجاري
#
MOYASAR_SECRET_KEY=sk_live_...
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_live_...
MOYASAR_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────
# 💰 بدائل تقسيط (اختياريّة · فعّليها لاحقاً فقط لو احتجت)
# ─────────────────────────────────────────────────────────────────
# اتركيها فاضية = ما تظهر للعميلة · تظهر تلقائيّاً لو ملأتيها
#
# Tabby · تقسيط 4 دفعات (300 - 30,000 ر.س)
TABBY_SECRET_KEY=
NEXT_PUBLIC_TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=SA

# Tamara · تقسيط 3 دفعات (100 - 15,000 ر.س)
TAMARA_API_TOKEN=
TAMARA_ENV=sandbox  # sandbox أو production


# ─────────────────────────────────────────────────────────────────
# 📱 الواتساب · Meta Cloud API (المجّاني الرسمي)
# ─────────────────────────────────────────────────────────────────
# الافتراضي الآن: Meta Direct (meta) · مجّاني لأوّل 1000 محادثة/شهر
# بديل اختياري (معلّق): ultramsg · twilio
#
WHATSAPP_PROVIDER=meta


# ── Meta WhatsApp Cloud API (المجّاني) ────────────────
# الخطوات:
#   1. business.facebook.com → انشائ WhatsApp Business Account
#   2. إضافة رقم جوّال (ليس مستخدم في واتساب شخصي)
#   3. من Meta Developers → Generate access token
#   4. انسخي Phone Number ID و Access Token هنا
#
# راجعي: docs/META_WHATSAPP_SETUP.md
#
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ── بدائل (اختياريّة · ليست مفعّلة افتراضيّاً) ─────────
# UltraMsg (رقم واتساب عادي · $10/شهر)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=


# ── ج) Twilio (بديل) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=


# ─────────────────────────────────────────────────────────────────
# 📧 Resend · الإيميلات (تأكيدات الحجز · إيميلات النظام)
# ─────────────────────────────────────────────────────────────────
# من:  https://resend.com
# مجّاناً حتى 3,000 إيميل/شهر
#
RESEND_API_KEY=
RESEND_FROM=noreply@thefirstlady.com


# ─────────────────────────────────────────────────────────────────
# 🔔 إشعارات الويب (Web Push) · اختياري
# ─────────────────────────────────────────────────────────────────
# ولّديها بـ:  npx web-push generate-vapid-keys
#
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@thefirstlady.com


# ─────────────────────────────────────────────────────────────────
# 🔔 Firebase · إشعارات الجوّال (اختياري · للتطبيق الأصلي)
# ─────────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=


# ─────────────────────────────────────────────────────────────────
# ☁️  النسخ الاحتياطي · Google Drive (اختياري)
# ─────────────────────────────────────────────────────────────────
# من:  console.cloud.google.com
#      Service Account → Download JSON
#
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=


# ─────────────────────────────────────────────────────────────────
# 📊 مراقبة الأخطاء · Sentry (موصى به)
# ─────────────────────────────────────────────────────────────────
# من:  https://sentry.io
# مجّاناً للمشاريع الصغيرة
#
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=


# ─────────────────────────────────────────────────────────────────
# 🔐 Cron Jobs · أمان المهام المجدولة
# ─────────────────────────────────────────────────────────────────
# سرّ طويل عشوائي (16+ حرف)
# يُولَّد بـ:  openssl rand -base64 32
#
CRON_SECRET=


# ─────────────────────────────────────────────────────────────────
# 🧪 Test Mode · للتطوير فقط (لا تضعيه في Production)
# ─────────────────────────────────────────────────────────────────
# لو true · الواتساب لا يُرسل · يُسجَّل في DB فقط
WHATSAPP_TEST_MODE=false
