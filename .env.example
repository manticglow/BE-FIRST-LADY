# ═══════════════════════════════════════════════════════════
# Be First Lady — Environment Variables
# انسخي هذا الملف لـ .env.local وعبّي القيم
# ═══════════════════════════════════════════════════════════

# ─── Supabase (لقاعدة البيانات والمصادقة) ─────────────────
# احصلي عليها من: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # للـ admin فقط

# ─── Site Configuration ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://befirstlady.com
NEXT_PUBLIC_WHATSAPP_NUMBER=966504389329

# ─── WhatsApp Cloud API (Meta) ────────────────────────────
# راجعي: docs/WHATSAPP_SETUP.md لإعداد كامل
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ═══ Payment Gateways ═════════════════════════════════════

# ─── Moyasar · مدى + Visa + Mastercard + Apple Pay + STC Pay ─
# من: https://moyasar.com/dashboard → API Keys
MOYASAR_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_live_xxx
MOYASAR_WEBHOOK_SECRET=  # من Dashboard → Webhooks

# ─── Tabby · تقسيط 4 دفعات (300-30,000 ر.س) ──────────────
# من: https://merchant.tabby.ai → Developer
TABBY_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_TABBY_PUBLIC_KEY=pk_live_xxx
TABBY_MERCHANT_CODE=SA

# ─── Tamara · تقسيط 3 دفعات (100-15,000 ر.س) ─────────────
# من: https://partners.tamara.co → API Keys
TAMARA_API_TOKEN=
TAMARA_ENV=sandbox  # أو production بعد التفعيل

# ─── Email (Resend) ───────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@befirstlady.com

# ─── Push Notifications (Firebase FCM) ────────────────────
# من Firebase Console → Service Account → Generate Private Key
FCM_PROJECT_ID=befirstlady-xxxxx
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Web Push (VAPID) · لإشعارات المتصفّح ─────────────────
# ولّديها بأمر: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@befirstlady.com

# ─── Analytics (اختياري) ──────────────────────────────────
# NEXT_PUBLIC_GA_ID=
